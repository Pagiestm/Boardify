# Copier ce fichier en .env.local et renseigner les valeurs

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Appwrite — console : Settings du projet
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=
NEXT_APPWRITE_KEY=

# Appwrite — Databases
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_WORKSPACES_ID=
NEXT_PUBLIC_APPWRITE_MEMBERS_ID=
NEXT_PUBLIC_APPWRITE_PROJECTS_ID=
NEXT_PUBLIC_APPWRITE_TASKS_ID=
NEXT_PUBLIC_APPWRITE_LABELS_ID=
NEXT_PUBLIC_APPWRITE_COMMENTS_ID=
NEXT_PUBLIC_APPWRITE_ACTIVITIES_ID=
NEXT_PUBLIC_APPWRITE_NOTIFICATIONS_ID=
NEXT_PUBLIC_APPWRITE_CHECKLIST_ITEMS_ID=
NEXT_PUBLIC_APPWRITE_ATTACHMENTS_ID=
NEXT_PUBLIC_APPWRITE_TASK_TEMPLATES_ID=
NEXT_PUBLIC_APPWRITE_SAVED_VIEWS_ID=
NEXT_PUBLIC_APPWRITE_SPRINTS_ID=
NEXT_PUBLIC_APPWRITE_AI_SETTINGS_ID=
NEXT_PUBLIC_APPWRITE_PRESENCE_ID=

# Base de données : `appwrite` (par défaut) ou `postgres`
DB_PROVIDER=
# Postgres. En local avec `docker compose up -d` :
# postgres://boardify:boardify@localhost:5434/boardify
DATABASE_URL=
# Facultatif : connexion directe (sans pooler) pour le temps réel, si DATABASE_URL passe par un pooler
DATABASE_DIRECT_URL=

# Connexion : `appwrite` (par défaut) ou `better-auth` (comptes dans Postgres, DATABASE_URL requise)
AUTH_PROVIDER=
# Better Auth : secret de signature (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Better Auth : connexion Google et GitHub (applications OAuth, distinctes de la GitHub App)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# E-mails (mot de passe oublié avec Better Auth). En local avec Mailpit : smtp://localhost:1026
SMTP_URL=
EMAIL_FROM=

# Fichiers : `appwrite` (par défaut) ou `s3` (Cloudflare R2, Scaleway, AWS, RustFS…)
STORAGE_PROVIDER=
# En local avec RustFS (docker compose) : http://localhost:9000, boardify / boardify-secret, bucket boardify
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Appwrite — Storage
NEXT_PUBLIC_APPWRITE_IMAGES_BUCKET_ID=

# GitHub App — optionnel : crée une issue pour chaque tâche des projets liés à un dépôt
# Page de l'app sur GitHub : slug dans l'URL, Client ID, client secret et clé privée (.pem)
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Secret du webhook de l'app (synchronisation GitHub → Boardify), par ex. `openssl rand -hex 32`
GITHUB_APP_WEBHOOK_SECRET=

# Tâches planifiées Vercel (notification « échéance demain »), par ex. `openssl rand -hex 32`
CRON_SECRET=

# Chiffrement des clés d'API de l'assistant IA (openssl rand -base64 32)
AI_ENCRYPTION_KEY=

# Sentry (suivi des erreurs en production). Facultatif : sans DSN, Sentry est désactivé.
NEXT_PUBLIC_SENTRY_DSN=
# Facultatif : pour des traces d'erreur lisibles (envoi des sources au build).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
