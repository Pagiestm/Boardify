{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boardify",
  "version": "../package.json",
  "identifier": "com.theotimepagies.boardify",
  "build": {
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Gestion de projets simple pour les équipes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["boardify"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNzFBNEYxOERFM0U5MEIKUldRTDZlT044YVJ4L0RxQlFFd3hYSmJURGZWTDd3SVZwRllnNzJKeXh1SGJiUXJjYjY4eS9PMnoK",
      "endpoints": ["https://github.com/Pagiestm/Boardify/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
